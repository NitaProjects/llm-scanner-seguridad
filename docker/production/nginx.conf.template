worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null crit;
events { worker_connections 128; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format minimal '$request_method $status $request_time $upstream_status';
    access_log /dev/stdout minimal;
    server_tokens off;
    client_max_body_size 1m;
    client_body_buffer_size 16k;
    client_body_temp_path /var/cache/nginx/client_temp;
    proxy_temp_path /var/cache/nginx/proxy_temp;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 8k;
    client_header_timeout 15s;
    client_body_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_conn_zone $binary_remote_addr zone=per_ip:1m;
    limit_conn_zone $server_name zone=per_server:1m;
    limit_conn_status 429;
    map $host $valid_host { default 0; "${PUBLIC_HOSTNAME}" 1; }
    map "$request_method:$http_origin" $invalid_origin {
        default 1;
        ~^(GET|HEAD|OPTIONS): 0;
        "POST:${PUBLIC_ORIGIN}" 0;
        "PUT:${PUBLIC_ORIGIN}" 0;
        "PATCH:${PUBLIC_ORIGIN}" 0;
        "DELETE:${PUBLIC_ORIGIN}" 0;
    }
    map $http_content_encoding $invalid_encoding { default 1; "" 0; ~*^identity$ 0; }
    server {
        listen 8443 ssl default_server;
        server_name ${PUBLIC_HOSTNAME};
        ssl_certificate /run/tls/active/fullchain.pem;
        ssl_certificate_key /run/tls/active/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        auth_basic "LLM Scanner Seguridad";
        auth_basic_user_file /run/auth/htpasswd;
        limit_conn per_ip 8;
        limit_conn per_server 32;
        if ($valid_host = 0) { return 421; }
        if ($invalid_origin = 1) { return 403; }
        if ($invalid_encoding = 1) { return 415; }
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        root /usr/share/nginx/html;
        location = /api { include /opt/proxy.conf; }
        location ^~ /api/ { include /opt/proxy.conf; }
        location ~ /\. { return 404; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
