FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /source/frontend
RUN npm install --global npm@10.8.2
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build -- --configuration production

FROM nginx:stable-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
COPY --from=build /source/frontend/dist/frontend/browser/ /usr/share/nginx/html/
COPY docker/production/nginx.conf.template /opt/nginx.conf.template
COPY docker/production/proxy.conf /opt/proxy.conf.template
COPY --chmod=555 docker/production/ingress-entrypoint.sh docker/production/readiness.sh /opt/
USER 101:101
EXPOSE 8443
ENTRYPOINT ["/opt/ingress-entrypoint.sh"]
