{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "reasoningSummary",
    "suggestedSeverity",
    "recommendation",
    "evidenceReferences"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "VULNERABLE",
        "NOT_VULNERABLE",
        "INCONCLUSIVE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoningSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "suggestedSeverity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        null
      ]
    },
    "recommendation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "evidenceReferences": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "start",
          "end",
          "criterionId"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "enum": [
              "response"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "criterionId": {
            "type": "string"
          }
        }
      }
    }
  }
}
